## OTHER SHENANIGANS

## now some more shenanigans
Y = [y0, y1, y2, y3, y4]
HM = Matrix(Rp2, [
    [ Burkhardt_f.derivative(Y[i]).derivative(Y[j]) for i in range(5)] for j in range(5)
]) / 3

def get_h(t):
    t2 = (t[0], 2*t[1], 2*t[2], 2*t[3], 2*t[4])
    return HM(t2).right_kernel().basis()[0]

def get_h2(t):
    t0, t1, t2, t3, t4 = t
    h1 = - (t0**3 + 2*t1**3 - 1*(t2**3 + t3**3 + t4**3)) / (3*(t0*t1**2) - 3*(t2 * t3 * t4))
    h2 = - (t0**3 + 2*t2**3 - 1*(t1**3 + t3**3 + t4**3)) / (3*(t0*t2**2) - 3*(t1 * t3 * t4))
    h3 = - (t0**3 + 2*t3**3 - 1*(t1**3 + t2**3 + t4**3)) / (3*(t0*t3**2) - 3*(t1 * t2 * t4))
    h4 = - (t0**3 + 2*t4**3 - 1*(t1**3 + t2**3 + t3**3)) / (3*(t0*t4**2) - 3*(t1 * t2 * t3))
    return (1, h1, h2, h3, h4)

def get_hd(h):
    x0, x1, x2, x3, x4 = h
    d0 = 4*x0**3 + x1**3 + x2**3 + x3**3 + x4**3
    d1 = 3*(x0*x1**2 + x2*x3*x4)
    d2 = 3*(x0*x2**2 + x1*x3*x4)
    d3 = 3*(x0*x3**2 + x1*x2*x4)
    d4 = 3*(x0*x4**2 + x1*x2*x3)
    return (d0, d1, d2, d3, d4)

def get_td(t):
    t0, t1, t2, t3, t4 = t
    d0 = t0**3 + 2*(t1**3 + t2**3 + t3**3 + t4**3)
    d1 = 3*t0*t1**2 + 6 * t2*t3*t4
    d2 = 3*t0*t2**2 + 6 * t1*t3*t4
    d3 = 3*t0*t3**2 + 6 * t1*t2*t4
    d4 = 3*t0*t4**2 + 6 * t1*t2*t3
    return (d0, d1, d2, d3, d4)

def normalize(v):
    for vi in v:
        if vi != 0:
            return tuple([Fp(vx/vi) for vx in v])



